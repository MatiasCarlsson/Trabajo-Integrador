---
import type { GetStaticPaths } from 'astro';
import { getAllProductos } from '@services/productService';
import Layout from '@layouts/Layout.astro';
import ProductCard from '@components/ProductCard.astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const productosDB = await getAllProductos();

  return productosDB.map((producto) => ({
    params: {
      producto: producto.nombre
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, '-'),
    },
    props: {
      producto: {
        nombre: producto.nombre,
        precio: producto.precio,
        imagen: producto.imagen_url,
        descripcion: producto.descripcion,
        puntos: producto.puntos,
      },
    },
  }));
};

interface Producto {
  nombre: string;
  precio: number;
  imagen: string;
  descripcion: string;
  puntos: number;
}

export interface Props {
  producto: Producto;
}

const { producto } = Astro.props;
const precioFormato = new Intl.NumberFormat('es-ES', {
  style: 'currency',
  currency: 'ARS',
}).format(producto.precio);

// Helper para crear URLs con base path
function createURL(path: string) {
  const base = import.meta.env.BASE_URL || '/';
  const cleanPath = path.replace(/^\//, '');
  return base.endsWith('/') ? base + cleanPath : base + '/' + cleanPath;
}

const productosDB = await getAllProductos();

const productos = productosDB.map((p) => ({
  id: p.id.toString(),
  nombre: p.nombre,
  precio: p.precio,
  puntos: p.puntos,
  imagen: p.imagen_url,
  descripcion: p.descripcion,
}));

function getRandomProducts(arr: any[], n: number) {
  return arr
    .map((p) => ({ p, sort: Math.random() }))
    .sort((a, b) => a.sort - b.sort)
    .map(({ p }) => p)
    .slice(0, n);
}
const productosAleatorios = getRandomProducts(productos, 12);

const buttonStyles =
  'rounded-lg  px-4 py-2 text-sm text-bloom-bg transition-transform hover:scale-105 hover:bg-purple-700 focus:scale-90 focus:ring-purple-400 md:px-6 md:text-base';
---

<Layout title={`Detalles de ${producto.nombre}`}>
  <article
    class="jusce container mx-auto my-8 grid grid-cols-1 gap-2 px-4 md:grid-cols-2 md:gap-4"
  >
    <div
      class="order-2 mr-8 flex items-center justify-center rounded-lg bg-slate-50 md:order-1"
    >
      <img
        src={producto.imagen}
        alt={producto.nombre}
        class="size-72 object-contain p-4 transition-all duration-150 hover:scale-105 md:object-cover"
      />
    </div>

    <div class="order-1 md:order-2">
      <h1 class="mb-4 text-2xl font-bold md:text-3xl">{producto.nombre}</h1>

      <p class="mb-4 text-sm text-gray-700 md:text-base">
        {producto.descripcion}
      </p>

      <p class="mb-6 text-xl font-bold md:text-2xl">Precio: {precioFormato}</p>

      <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
        <button
          type="button"
          class={`${buttonStyles} bg-purple-500`}
          id="add-to-cart"
          data-id={producto.nombre
            .normalize('NFD')
            .replace(/[\u0300-\u036f]/g, '')
            .toLowerCase()
            .replace(/[^a-z0-9]+/g, '-')}
          data-nombre={producto.nombre}
          data-precio={producto.precio}
          data-imagen={producto.imagen}
        >
          Añadir al carrito
        </button>
        <a
          href={createURL('/productos')}
          class={`${buttonStyles} bg-opacity-80 bg-bloom-contrast`}
        >
          Volver a la tienda
        </a>
      </div>
    </div>
  </article>

  <section>
    <ProductCard productos={productosAleatorios} limite={12} />
  </section>
</Layout>

<script>
  declare global {
    interface Window {
      updateCartCount: () => void;
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    const button = document.getElementById('add-to-cart') as HTMLButtonElement;

    if (!button) {
      console.error('No se encontró el botón del carrito');
      return;
    }

    button.addEventListener('click', () => {
      const producto = {
        id: button.dataset.id!,
        nombre: button.dataset.nombre!,
        precio: Number(button.dataset.precio!),
        imagen: button.dataset.imagen!,
      };

      const carrito = JSON.parse(localStorage.getItem('carrito') || '[]');
      const existente = carrito.find((item: any) => item.id === producto.id);

      if (existente) {
        existente.cantidad = (existente.cantidad || 1) + 1;
      } else {
        carrito.push({ ...producto, cantidad: 1 });
      }

      localStorage.setItem('carrito', JSON.stringify(carrito));

      if (typeof window.updateCartCount === 'function') {
        window.updateCartCount();
      } else {
        console.error('❌ window.updateCartCount no existe');
      }

      alert(`${producto.nombre} ha sido añadido al carrito`);
    });
  });
</script>

---
import Instagram from './icons/Instagram.astro';
import WhatsApp from './icons/WhatsApp.astro';

const stylesSection =
  'flex flex-col items-start justify-start gap-2 md:gap-3 text-sm';
const stylesLink =
  'text-bloom-contrast hover:text-bloom-deep italic transition-colors duration-200 hover:underline';

// Helper para crear URLs con base path
function createURL(path: string) {
  const base = import.meta.env.BASE_URL || '/';
  const cleanPath = path.replace(/^\//, '');
  return base.endsWith('/') ? base + cleanPath : base + '/' + cleanPath;
}
---

<footer
  class="mt-10 w-full bg-gradient-to-b from-gray-50 from-0% via-gray-300 via-40% to-gray-900 to-100% py-6 text-bloom-contrast shadow-lg md:py-10"
>
  <div class="container mx-auto px-4 md:px-6 lg:px-8">
    <article
      class="grid grid-cols-1 gap-6 md:grid-cols-2 md:gap-8 lg:grid-cols-3"
    >
      <section class={`${stylesSection}`}>
        <h3 class="mb-2 text-base font-bold text-bloom-accent md:text-lg">
          Sobre Nosotros
        </h3>
        <p class="text-sm font-semibold text-bloom-contrast md:text-base">
          Hannah Dalila Bojanovich
        </p>
        <p class="text-sm font-semibold text-bloom-contrast md:text-base">
          Matías Viana Carlsson
        </p>
        <p class="mt-2 text-xs text-gray-700 md:text-sm">
          Distribuidores Mercantiles
        </p>
        <p class="text-xs text-gray-700 md:text-sm">
          Independientes de Omnilife
        </p>
        <p class="text-xs text-gray-700 md:text-sm">
          Código de Distribuidor: 123456
        </p>

        <div class="mt-3 flex gap-3 md:gap-4">
          <a
            href="https://www.instagram.com/bloom.distribuciones/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-bloom-contrast transition-colors duration-200 hover:text-pink-400"
            aria-label="Instagram"
          >
            <Instagram />
          </a>
          <a
            href="https://wa.me/5493764725856"
            target="_blank"
            rel="noopener noreferrer"
            class="text-bloom-contrast transition-colors duration-200 hover:text-green-400"
            aria-label="WhatsApp"
          >
            <WhatsApp />
          </a>
        </div>
      </section>

      <section class={stylesSection}>
        <h3 class="mb-2 text-base font-bold text-bloom-accent md:text-lg">
          Productos
        </h3>
        <a href={createURL('/productos')} class={stylesLink}
          >Ver Catálogo Completo</a
        >
        <a href={createURL('/acercaDeNosotros')} class={stylesLink}
          >Acerca de Nosotros</a
        >
        <a href={createURL('/contacto')} class={stylesLink}>Contacto</a>
      </section>

      <section class={stylesSection}>
        <h3 class="mb-2 text-base font-bold text-bloom-accent md:text-lg">
          Oportunidad de Negocio
        </h3>
        <a
          href="https://wa.me/5493764725856?text=Hola,%20¿Qué tal?%20quiero%20unirme%20al%20equipo%20de%20distribuidores"
          target="_blank"
          rel="noopener noreferrer"
          class={stylesLink}
        >
          Conviértete en Distribuidor Omnilife
        </a>
        <a
          href="https://portal.omnilife.com/"
          target="_blank"
          rel="noopener noreferrer"
          class={stylesLink}
        >
          Sitio Oficial Omnilife
        </a>
      </section>
    </article>
  </div>

  <article class="mt-6 border-t border-gray-100 pt-4 md:mt-8 md:pt-6">
    <div class="container mx-auto px-4 text-center md:px-6">
      <p class="mb-2 text-xs text-gray-200 md:mb-3 md:text-sm">
        Estos productos no son medicamentos. El consumo de estos productos es
        responsabilidad de quien los recomienda y de quien los usa.
      </p>
      <p class="mb-2 text-xs font-semibold text-white md:text-sm">
        © 2025 Hannah Dalila Bojanovich & Matías Viana Carlsson
      </p>
      <p class="text-xs text-gray-200 md:text-sm">
        Distribuidor Mercantil Independiente Omnilife. Este sitio web no es el
        sitio oficial de Omnilife de México S.A. de C.V.
      </p>
    </div>
  </article>
</footer>
